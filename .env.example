# Server-only configuration. Never expose these to the client.
# SvelteKit only injects vars without the PUBLIC_ prefix into server code.

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
# service_role bypasses RLS — must never reach the browser or be committed
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to HMAC-hash client IPs before persisting them (rate limiting)
RATE_LIMIT_SECRET=

# Shared secret protecting POST /api/cron/purge (Vercel Cron)
CRON_SECRET=

# ── Tunables (defaults shown) ──────────────────────────────────────────────
# Pastes above this size go to Supabase Storage instead of a Postgres column
PASTE_INLINE_THRESHOLD_BYTES=65536
# Hard cap on accepted paste size (5 MiB)
PASTE_MAX_BYTES=5242880
# Rate limit: byte budget per hashed IP per fixed window
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_BUDGET_BYTES=20971520

# Canonical site URL used to build returned paste links
PUBLIC_SITE_URL=https://paste.example.com
